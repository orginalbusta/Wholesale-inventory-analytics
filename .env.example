# Copy to .env (git-ignored) and fill in. Nothing here is required for the default DuckDB path.

# --- Public data (free key: https://fred.stlouisfed.org/docs/api/api_key.html) ---
FRED_API_KEY=

# --- Warehouse selection for dlt loads: duckdb (default) | snowflake ---
WAREHOUSE=duckdb
DUCKDB_PATH=warehouse/craftstones.duckdb

# --- Snowflake (optional, Phase 8). Use key-pair auth, not passwords. ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CRAFTSTONES_ANALYTICS
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Generator ---
GENERATOR_SEED=42
